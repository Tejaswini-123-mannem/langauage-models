# =============================================================================
# Large artifacts
# =============================================================================
#
# The assignment requires datasets, tokenized corpora and checkpoints to
# live on Google Drive with shareable links in the README, and explicitly
# forbids committing large binary artifacts to git.
#
# All corpus data for this project lives under:
#     G:\My Drive\LMA_Individual_Project\
# which is outside the repository, so nothing here is a substitute for
# keeping the Drive links in README.md up to date.
# =============================================================================

# Source PDFs and raw inputs
*.pdf
**/input/
**/raw/

# Corpus and intermediate data
*.jsonl
*.arrow
*.bz2
*.xml
**/checkpoints/
**/ocr_checkpoints/
**/final/

# Trained tokenizers and models
*.model
*.vocab
*.pt
*.ckpt
*.safetensors

# Tokenizer training text (regenerated by train_tokenizer.py)
*_input.txt

# =============================================================================
# Keep: small artifacts that ARE deliverables
# =============================================================================
#
# Reports, figures, statistics and configuration files are graded from the
# branch, so they are force-included ahead of the patterns above.
# =============================================================================

!report/**
!**/configs/*.json
!*.csv
!requirements.txt

# =============================================================================
# Python
# =============================================================================

.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# =============================================================================
# Editors and OS
# =============================================================================

.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Phase 2 -----------------------------------------------------------------
# Kaggle API credentials. Created by kaggle.com -> Settings -> API -> Create New
# Token and normally kept at ~/.kaggle/kaggle.json; ignored here in case a copy
# is ever placed in the repo. It is a secret key.
kaggle.json
access_token
.kaggle/
